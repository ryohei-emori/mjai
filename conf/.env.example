# =============================================================================
# MJAI local / deployment environment template
# Copy to conf/.env and fill in real values. Never commit conf/.env.
#
# Architecture (current):
#   - App DB + Auth: Supabase (Postgres + Google OAuth / JWT)
#   - Backend API: FastAPI on Vercel (local: docker-compose → :8000)
#   - Frontend: Next.js on Vercel (local: docker-compose → :3000)
#   - AI suggestions: client-side WebLLM (no server-side GEMINI_* keys)
# Google OAuth client secrets live in the Supabase Auth provider dashboard
# (and optionally conf/client_secret*.json locally) — not in app env vars.
#
# Multi-Environment Architecture:
#   - DB共有 (Shared DB): Same DATABASE_URL for local and production
#   - 認証分け (Environment-Aware Auth): Same Supabase project, different
#     redirect URLs per environment (auto-detected via window.location.origin)
#   - Same user can log in from both local and production (shared auth.users)
#
# Vercel monorepo deployment:
#   - Frontend: serves at / (Next.js)
#   - Backend: serves at /api/* (FastAPI serverless function)
#   - For same-origin deployment, NEXT_PUBLIC_API_URL can be empty or /api
#
# Env file layout:
#   - Source of truth for local + secrets: this file copied to conf/.env
#   - Local docker-compose reads conf/.env (do not commit it)
#   - Vercel production secrets: `vercel env add` / dashboard (not conf/.env alone)
#   - Optional: symlink repo-root .env -> conf/.env for tools that expect WD/.env
#     (already gitignored by root .env*). Do NOT commit root .env.
#   - Do NOT blindly push conf/.env to Vercel Production: override
#     ENVIRONMENT=production, NEXT_PUBLIC_API_URL=/api (or empty),
#     and FRONTEND_URL=https://<your-app>.vercel.app after first deploy.
#
# External Config Required (not in this file):
#   - Google Cloud Console: OAuth client with both localhost and prod origins
#   - Supabase Dashboard: Auth URL config with both redirect URLs
#   - See AGENTS.md "Multi-Environment Architecture" section for details
# =============================================================================

# Database (Supabase Postgres) — primary app data store
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# App always uses Postgres/Supabase; keep true for clarity (SQLite dual-path removed).
USE_POSTGRESQL=true

# Migration-only variables (safe to omit after one-time data migration is complete)
# SOURCE_DATABASE_URL=postgresql://postgres:[OLD-PASSWORD]@[OLD-HOST]:5432/postgres
# TARGET_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[NEW-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Auth (Google sign-in)
# IMPORTANT: Same values for both local and production (shared Supabase project).
# The frontend auto-detects the correct redirect URL via window.location.origin.
# Browser-side client config (safe to expose; NEXT_PUBLIC_* is baked into the frontend build)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backend-only secret used to verify Supabase-issued JWTs
# (Supabase project settings → API → JWT Secret). Never expose as NEXT_PUBLIC_*.
# Same secret for both local and production (same Supabase project).
SUPABASE_JWT_SECRET=
# Google-auth allow-list (case-insensitive). Comma-separate multiple addresses if needed.
# Backend also accepts ALLOWED_USER_EMAILS as an alias.
# Same allow-list for both environments (shared user pool).
ALLOWED_USER_EMAIL=

# Optional / legacy: not read by current backend or frontend code
# SUPABASE_SERVICE_ROLE_KEY=

# AI Suggestion Providers (backend-only, NOT NEXT_PUBLIC_*)
# Primary: Groq (fast, ~1-3s inference)
# Multi-key pool (comma-separated). When non-empty, overrides GROQ_API_KEY.
# GROQ_API_KEYS=gsk_key1,gsk_key2
# Singular back-compat (still supported; used when GROQ_API_KEYS is unset/empty):
GROQ_API_KEY=
# Optional: pin a single Groq model id (disables model rotation)
# GROQ_MODEL=
# Fallback: Cloudflare Workers AI (used when Groq fails or is rate-limited)
# Parallel multi-credential lists (same length). When either is set, both must
# match in length; mismatched lengths disable the Cloudflare pool.
# CLOUDFLARE_ACCOUNT_IDS=account_id_1,account_id_2
# CLOUDFLARE_API_TOKENS=cfut_token_1,cfut_token_2
# Singular back-compat (used when plural lists are unset/empty):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# WebLLM remains available on frontend as offline fallback (no backend config needed)

# REMOVED / obsolete — Gemini no longer used:
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Local docker-compose defaults (see repo-root docker-compose.yml)
ENVIRONMENT=development
# Backend CORS allow-list origin for the Next.js app (also hardcoded for localhost:3000 in main.py)
FRONTEND_URL=http://localhost:3000
# Browser-side API base URL. Must be reachable from the user's browser (host-mapped
# port), NOT the docker-compose service hostname `backend`. docker-compose.yml
# overrides this to http://localhost:8000 for the frontend service.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Unused alias — frontend reads NEXT_PUBLIC_API_URL only (see frontend/src/app/api.ts)
NEXT_PUBLIC_API_BASE_URL=

# Production overrides (set in Vercel dashboard → Environment Variables)
# For Vercel monorepo deployment (frontend + backend on same Vercel project):
#   NEXT_PUBLIC_API_URL= (empty or /api for same-origin)
#   FRONTEND_URL=https://[YOUR-VERCEL-APP].vercel.app
# For separate Vercel projects (cross-origin):
#   NEXT_PUBLIC_API_URL=https://[YOUR-API-PROJECT].vercel.app/api
#   FRONTEND_URL=https://[YOUR-FRONTEND-PROJECT].vercel.app

# Path plumbing for local / container runs
PROJECT_ROOT=
PYTHONPATH=./backend
APP_ROOT=./backend
