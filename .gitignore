# Dependencies
node_modules/
.pnp
.pnp.*

# Build outputs
.next/
out/
build/
dist/

# Environment variables
.env*
!.env.example
# Keep conf/.env.example trackable even if nested under conf/
!conf/.env.example

# Vercel CLI link metadata (org/project ids); recreate with `vercel link`
.vercel/

# Google OAuth client secrets (never commit)
conf/client_secret*.json
**/client_secret*.json
*apps.googleusercontent.com.json


# Logs
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Runtime data
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/

# Database
*.sqlite3
*.db

# DB backup snapshots (pg_dump / asyncpg fallback) — never commit live data dumps
backend/db/*_backup_*.sql
backend/db/*_backup_*.json
backend/db/*_backup_*.csv

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
tfplan
crash.log
crash.*.log

# TypeScript
*.tsbuildinfo
.vercel
